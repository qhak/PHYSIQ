{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cutrank-site",
  "main": "worker/site.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "cutrank.app", "custom_domain": true },
    { "pattern": "www.cutrank.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
